{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Mongo": {
    "Database": "CoursePilot"
  },
  "Authentication": {
    "CookieHours": 8
  },
  "RateLimits": {
    "IdentityPermitLimit": 20,
    "IdentityWindowMinutes": 1
  },
  "DataProtection": {
    "KeysPath": ""
  },
  "AllowedHosts": "*"
}
